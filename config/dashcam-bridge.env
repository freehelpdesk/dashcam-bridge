# Copy of this file is installed to /etc/dashcam-bridge.env on first provision.
# After that, the Pi reads /etc/dashcam-bridge.env. Edit that copy to change a live box.

# Two-letter Wi-Fi country. The access point will not start until this is set.
WIFI_COUNTRY=US
WIFI_IFACE=wlan0

# Saved networks. The Pi joins whichever of these is actually on.
# A higher priority wins when more than one is in range, even if another
# is louder. Put the house first so the driveway uses the house LAN, and
# the car's Starlink second so the road uses that. Give two networks the
# same priority to break that tie by signal strength instead.
# Up to 8 (WIFI_NET_3_SSID ... WIFI_NET_8_SSID). Leave an SSID blank to skip it.
# Leave PRIORITY blank and slot 1 is 100, slot 2 is 90, slot 3 is 80, counting down by 10.
# Set a road network to 10, same as Starlink, when the stronger signal should win between them.
# The network has to broadcast its name. HOME_SSID / HOME_PSK are still accepted
# as one more network at priority 100.
WIFI_NET_1_SSID=
WIFI_NET_1_PSK=
WIFI_NET_1_PRIORITY=100

WIFI_NET_2_SSID=
WIFI_NET_2_PSK=
WIFI_NET_2_PRIORITY=10

# Fallback network the Pi broadcasts when none of the saved networks are in range.
# The laptop joins this and opens smb://192.168.4.1/dashcam
AP_SSID=dashcam
AP_PSK=CHANGEME

# Read-only SMB account. This is not an SSH login.
SMB_USER=dashcam
SMB_PASSWORD=CHANGEME

# Backing disk the car writes to. IMAGE_GB must fit on the card or SSD
# together with COW_GB and the OS. 128 GiB is above the car's 64 GB floor.
# IMAGE_FS=ext4 keeps a journal, which makes the live snapshot mountable.
# Set exfat if a particular car keeps asking to format an ext4 drive.
#
# STORAGE=sd keeps a cam.img file on the boot disk. STORAGE=nvme uses the
# internal NVMe itself as the drive the car writes. STORAGE=usb does the same
# with an external USB disk. Snapshot scratch stays on the boot disk.
# A blank disk is partitioned. A disk that already holds data is left alone.
# IMAGE_GB sizes the image file and applies when STORAGE=sd. If the NVMe or
# USB disk is the one the Pi boots from, clips stay in the image file.
STORAGE=sd
IMAGE_DIR=/var/lib/dashcam-bridge
IMAGE_GB=128
COW_GB=16
IMAGE_FS=ext4

# live: the share reads and writes the disk the USB host uses. A file shows
# up within a couple of seconds after that computer ejects the disk. Do not
# write from SMB while the car has the USB disk open.
# snapshot: the share is a frozen view. It updates about once a minute,
# and only while nobody is connected, so a long copy stays stable.
SHARE=live

# 0 asks the car to flush writes. 1 is faster and can lose the last seconds
# of a clip when the car cuts USB power.
GADGET_NOFUA=0

# bus: the car's USB port powers the Pi (the Pi 4 one-cable build).
# external: a separate 5 V supply powers the Pi, and the USB-C cable to the
# car must not carry 5 V as well.
POWER_SOURCE=bus
