# Copy of this file is installed to /etc/dashcam-bridge.env on first provision.
# After that, the Pi reads /etc/dashcam-bridge.env. Edit that copy to change a live box.
#
# This file is read by the shell. Quote a value that has spaces or symbols.
# Single quotes are safest: WIFI_NET_1_SSID='My House' or AP_PSK='pa$$ word'

# Two-letter Wi-Fi country. The access point will not start until this is set.
WIFI_COUNTRY=US
WIFI_IFACE=wlan0

# Saved networks. The Pi joins whichever of these is actually on.
# A higher priority wins when more than one is in range, even if another
# is louder. Put the house first so the driveway uses the house LAN, and
# the car's Starlink second so the road uses that. Give two networks the
# same priority to break that tie by signal strength instead.
# Up to 8 (WIFI_NET_3_SSID ... WIFI_NET_8_SSID). Leave an SSID blank to skip it.
# Leave PRIORITY blank and slot 1 is 100, slot 2 is 90, slot 3 is 80, counting down by 10.
# Set a road network to 10, same as Starlink, when the stronger signal should win between them.
# The network has to broadcast its name. HOME_SSID / HOME_PSK are still accepted
# as one more network at priority 100.
WIFI_NET_1_SSID=
WIFI_NET_1_PSK=
WIFI_NET_1_PRIORITY=100

WIFI_NET_2_SSID=
WIFI_NET_2_PSK=
WIFI_NET_2_PRIORITY=10

# Fallback network the Pi broadcasts when none of the saved networks are in range.
# The laptop joins this and opens smb://192.168.4.1/dashcam
AP_SSID=dashcam
AP_PSK=CHANGEME

# SMB account for the dashcam and dashcam-inbox shares. This is not an SSH login.
SMB_USER=dashcam
SMB_PASSWORD=CHANGEME

# Backing disk the car writes to. IMAGE_GB must fit on the card or SSD
# together with COW_GB and the OS. 128 GiB is above the car's 64 GB floor.
# IMAGE_FS=ext4 keeps a journal, which makes the live snapshot mountable.
# Set exfat if a particular car keeps asking to format an ext4 drive.
#
# STORAGE=sd keeps a cam.img file on the boot disk. STORAGE=nvme uses the
# internal NVMe itself as the drive the car writes. STORAGE=usb does the same
# with an external USB disk. Snapshot scratch stays on the boot disk.
# A blank disk is partitioned. A disk that already holds data is left alone.
# IMAGE_GB sizes the image file and applies when STORAGE=sd. If the NVMe or
# USB disk is the one the Pi boots from, clips stay in the image file.
STORAGE=sd
IMAGE_DIR=/var/lib/dashcam-bridge
IMAGE_GB=128
COW_GB=16
IMAGE_FS=ext4

# snapshot: the share is a frozen, read-only view. It updates about once a
# minute, and only while nobody is connected, so a long copy stays stable.
# To write to the drive, drop files on the dashcam-inbox share. They are
# written when the car is idle, with the car and the Pi never writing at once.
# live: the share reads and writes the disk the USB host uses. A file shows
# up within a couple of seconds after that computer ejects the disk. The car
# and the Pi can write at the same time, which can corrupt the drive.
SHARE=snapshot

# Size of the inbox, in GiB, taken from the boot disk. 0 turns it off.
INBOX_GB=4
# Wait until the car has written nothing for this long.
INBOX_IDLE_SECS=120
# Wait until nothing has changed in the inbox for this long.
INBOX_SETTLE_SECS=60
# Longest the car goes without its drive per run. Files past this limit wait
# for the next idle window. A single file is always finished once started.
INBOX_MAX_SECS=60

# 0 asks the car to flush writes. 1 is faster and can lose the last seconds
# of a clip when the car cuts USB power.
GADGET_NOFUA=0

# bus: the car's USB port powers the Pi (the Pi 4 one-cable build).
# external: a separate 5 V supply powers the Pi, and the USB-C cable to the
# car must not carry 5 V as well.
POWER_SOURCE=bus

# GPIO that selects the glovebox carrier's USB mux. Empty leaves the pin
# alone, which is what a stock Pi wants. Set 17 on the CM5 carrier: high
# hands the car this gadget after it binds, low returns the passthrough socket.
USB_TAKEOVER_GPIO=

# 1 lowers the peak current of a Pi 5: the CPU is capped at 1.5 GHz, PCIe runs
# at Gen 1, and an NVMe drive is held to its lowest-power working state. The
# car's speed does not change. SMB copies can be slower. This helps a marginal
# supply. It cannot add current. Run provision and reboot after changing it.
REDUCED_POWER=0

# 1 reads speed, braking, GPS, and acceleration out of each finished clip and
# serves them on TELEMETRY_PORT. Alerts come a few seconds to about a minute
# after an event, because a clip has to finish first. Needs unencrypted clips.
TELEMETRY=0
# Anyone with this token can read your GPS history. 16 or more characters.
# One way to make one: openssl rand -hex 24
TELEMETRY_TOKEN=CHANGEME
TELEMETRY_PORT=8088
# 0.0.0.0 is every network the Pi joins. Never forward this port on a router.
TELEMETRY_BIND=0.0.0.0
# Force, in m/s2, that counts as hard (9.8 is 1 g), and how long it has to last.
TELEMETRY_BRAKE_MPS2=4
TELEMETRY_ACCEL_MPS2=4
TELEMETRY_CORNER_MPS2=4
TELEMETRY_HOLD_MS=250
TELEMETRY_KEEP_DAYS=30
# Default webhook, used by any alert below without its own. Blank sends nothing
# unless that alert has its own. Quote a URL that has & in it.
# json suits Discord, Slack, and Home Assistant. text suits ntfy.
TELEMETRY_WEBHOOK_URL=
TELEMETRY_WEBHOOK_FORMAT=json
# 1 includes the car's location, city, and street in alerts sent to a webhook.
TELEMETRY_WEBHOOK_GPS=0

# Each alert is off, log (stored, and on the API, but never sent), or alert.
# Each can have its own webhook. Add TELEMETRY_ALERT_<NAME>_WEBHOOK_FORMAT=text
# to give one alert a different format from the default.
# Hard braking, above TELEMETRY_BRAKE_MPS2.
TELEMETRY_ALERT_HARD_BRAKE=alert
TELEMETRY_ALERT_HARD_BRAKE_WEBHOOK=

# Hard acceleration, above TELEMETRY_ACCEL_MPS2.
TELEMETRY_ALERT_HARD_ACCEL=alert
TELEMETRY_ALERT_HARD_ACCEL_WEBHOOK=

# Hard cornering, above TELEMETRY_CORNER_MPS2.
TELEMETRY_ALERT_HARD_CORNER=alert
TELEMETRY_ALERT_HARD_CORNER_WEBHOOK=

# A very short, sharp force. Not an emergency alert: a crash can cut power first.
TELEMETRY_ALERT_IMPACT=off
TELEMETRY_ALERT_IMPACT_WEBHOOK=

# Steering swung both ways within 1.5 s at speed, with side force.
TELEMETRY_ALERT_SWERVE=off
TELEMETRY_ALERT_SWERVE_WEBHOOK=

# A vertical jolt, stored with its GPS position.
TELEMETRY_ALERT_POTHOLE=off
TELEMETRY_ALERT_POTHOLE_WEBHOOK=

# Autopilot or FSD ended alongside hard braking or a sharp steering input.
TELEMETRY_ALERT_AUTOPILOT_TAKEOVER=alert
TELEMETRY_ALERT_AUTOPILOT_TAKEOVER_WEBHOOK=

# A manual lane change with no blinker. Rough, so expect some wrong ones.
TELEMETRY_ALERT_LANE_NO_BLINKER=off
TELEMETRY_ALERT_LANE_NO_BLINKER_WEBHOOK=

# A blinker left on at speed.
TELEMETRY_ALERT_BLINKER_LEFT_ON=off
TELEMETRY_ALERT_BLINKER_LEFT_ON_WEBHOOK=

# Over TELEMETRY_SPEEDING_MPH, or a zone limit.
TELEMETRY_ALERT_SPEEDING=off
TELEMETRY_ALERT_SPEEDING_WEBHOOK=

# Arrived at or left a TELEMETRY_GEOFENCE_ZONES place.
TELEMETRY_ALERT_GEOFENCE=off
TELEMETRY_ALERT_GEOFENCE_WEBHOOK=

# A drive in TELEMETRY_UNEXPECTED_HOURS, or outside TELEMETRY_UNEXPECTED_AREA.
TELEMETRY_ALERT_UNEXPECTED_USE=off
TELEMETRY_ALERT_UNEXPECTED_USE_WEBHOOK=

# Sent when the car is put in park.
TELEMETRY_ALERT_TRIP_SUMMARY=alert
TELEMETRY_ALERT_TRIP_SUMMARY_WEBHOOK=

# A new SentryClips folder, with the reason the car gave.
TELEMETRY_ALERT_SENTRY_EVENT=alert
TELEMETRY_ALERT_SENTRY_EVENT_WEBHOOK=

# A new SavedClips folder, with the reason the car gave.
TELEMETRY_ALERT_SAVED_CLIP=alert
TELEMETRY_ALERT_SAVED_CLIP_WEBHOOK=

# No new clip mid-drive for TELEMETRY_RECORDING_STOPPED_SECS.
TELEMETRY_ALERT_RECORDING_STOPPED=alert
TELEMETRY_ALERT_RECORDING_STOPPED_WEBHOOK=

# Undervoltage, throttling, or a temperature limit since boot.
TELEMETRY_ALERT_POWER_TROUBLE=alert
TELEMETRY_ALERT_POWER_TROUBLE_WEBHOOK=

# The drive or the snapshot scratch is nearly full.
TELEMETRY_ALERT_STORAGE_FULL=off
TELEMETRY_ALERT_STORAGE_FULL_WEBHOOK=

# Clips stopped carrying SEI, or the car started encrypting them.
TELEMETRY_ALERT_TELEMETRY_LOST=off
TELEMETRY_ALERT_TELEMETRY_LOST_WEBHOOK=

# Settings for those alerts. Force is in m/s2, and 9.8 is 1 g.
TELEMETRY_IMPACT_MPS2=12
TELEMETRY_POTHOLE_MPS2=4
# Steering wheel degrees within 1.5 s, side force, and the slowest speed that counts.
TELEMETRY_SWERVE_STEER_DEG=30
TELEMETRY_SWERVE_MPS2=3
TELEMETRY_SWERVE_MIN_MPH=25
# Seconds either side of Autopilot ending, and how hard counts as a takeover.
TELEMETRY_TAKEOVER_WINDOW_SECS=2
TELEMETRY_TAKEOVER_BRAKE_MPS2=2.5
TELEMETRY_TAKEOVER_STEER_DPS=180
TELEMETRY_LANE_MIN_MPH=35
TELEMETRY_BLINKER_SECS=30
TELEMETRY_BLINKER_MIN_MPH=45
# 0 turns off the fixed limit, leaving only the zones.
TELEMETRY_SPEEDING_MPH=85
TELEMETRY_SPEEDING_SECS=5
# Quote these. name:lat,lon:radius_m:mph, with ; between zones.
TELEMETRY_SPEEDING_ZONES=
# Quote these. name:lat,lon:radius_m, with ; between zones.
TELEMETRY_GEOFENCE_ZONES=
# Hours, on the 24 hour clock. 23-5 is 11 pm to 5 am.
TELEMETRY_UNEXPECTED_HOURS=
# lat,lon:radius_m
TELEMETRY_UNEXPECTED_AREA=
TELEMETRY_TRIP_MIN_MILES=0.2
TELEMETRY_RECORDING_STOPPED_SECS=300
TELEMETRY_DRIVE_FULL_PCT=90
TELEMETRY_SCRATCH_FULL_PCT=80
# Clips in a row with no SEI. A parked car can record over 100 of these.
TELEMETRY_SEI_LOST_CLIPS=240
# 1 records when the car's writes reach the Pi, on each boot, for up to an
# hour of writing. See docs/operations.md. Turn it off once you have a result.
TELEMETRY_WRITE_LOG=0
