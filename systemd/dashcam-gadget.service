[Unit]
Description=USB drive presented to the car
DefaultDependencies=no
After=dashcam-storage.service systemd-modules-load.service sys-kernel-config.mount
Wants=sys-kernel-config.mount
Requires=dashcam-storage.service
Before=shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/dashcam-bridge.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/dashcam-bridge/gadget-up.sh
ExecStop=/usr/local/lib/dashcam-bridge/gadget-down.sh

[Install]
WantedBy=multi-user.target
