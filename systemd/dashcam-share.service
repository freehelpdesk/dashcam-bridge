[Unit]
Description=Mount the dashcam share and reload Samba
After=dashcam-storage.service dashcam-gadget.service smbd.service
Requires=dashcam-storage.service
Wants=smbd.service
ConditionPathExists=/etc/dashcam-bridge.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/lib/dashcam-bridge/share-up.sh
ExecStart=/usr/bin/systemctl reload-or-restart smbd.service

[Install]
WantedBy=multi-user.target
