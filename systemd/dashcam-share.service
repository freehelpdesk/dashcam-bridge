[Unit]
Description=Reload Samba once the dashcam snapshot is mounted
After=dashcam-storage.service smbd.service
Requires=dashcam-storage.service
Wants=smbd.service
ConditionPathExists=/etc/dashcam-bridge.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl reload-or-restart smbd.service

[Install]
WantedBy=multi-user.target
