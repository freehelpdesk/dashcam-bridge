[Unit]
Description=Dashcam backing store and snapshot
# The car is waiting for this drive, so start as soon as the disks are usable
# instead of after the rest of early boot.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service
Before=dashcam-gadget.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/dashcam-bridge.env

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=7200
ExecStart=/usr/local/lib/dashcam-bridge/storage-up.sh
ExecStop=/usr/local/lib/dashcam-bridge/storage-down.sh

[Install]
WantedBy=multi-user.target
