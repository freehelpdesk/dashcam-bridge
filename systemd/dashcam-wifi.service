[Unit]
Description=Best saved Wi-Fi network, or the dashcam access point
After=NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=/etc/dashcam-bridge.env

[Service]
Type=oneshot
# Up to eight networks at 25 s each, then the access point on two bands.
TimeoutStartSec=300
ExecStart=/usr/local/lib/dashcam-bridge/wifi.sh
